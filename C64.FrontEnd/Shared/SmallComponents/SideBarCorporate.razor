@namespace C64.FrontEnd.Shared

@using System.Timers

@implements IDisposable

@inject IUnitOfWorkFactory unitOfWorkFactory
@inject IJSRuntime jsRuntime

<Box ContentClasses="text-left p-1 overflow-hidden">
    <Title>Corporate</Title>
    <Content>
        &copy; 1998-@DateTime.Now.Year
        <a href="https://c64.ch">C64.CH</a>
        <br />
        <a href="https://github.com/Sabbi/C64.CH" target="_blank" rel="noopener">GitHub</a> -
        <a href="https://bsky.app/profile/c64-ch.bsky.social" target="_blank" rel="noopener">BlueSky</a> -
        <a rel="me" href="https://mas.to/@@c64" target="_blank">Mastodon</a>
        <hr />
        @if (latency is null)
        {
            <span>LOAD"*",8,1</span>
        }
        else
        {
            <span data-placement="top" title="Should be 250ms or less for reasonable experience (according to MS)">Network latency: @(latency.Value.TotalMilliseconds)ms</span>
        }
    </Content>
</Box>
@code{

    private DateTime startTime;
    private TimeSpan? latency;

    private Timer timeTimer = new Timer();

    private IUnitOfWork unitOfWork;

    // The circuit can be torn down 
    private volatile bool disposed;

    protected override void OnInitialized()
    {
        unitOfWork = unitOfWorkFactory.Create();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateLatency();

            if (disposed)
                return;

            timeTimer.Interval = 4000;
            timeTimer.Elapsed += OnTimerElapsed;
            timeTimer.Start();
        }
    }

    private async void OnTimerElapsed(object sender, ElapsedEventArgs e)
    {
        if (disposed)
            return;

        await UpdateLatency();
    }

    private async Task UpdateLatency()
    {
        try
        {
            startTime = DateTime.UtcNow;
            var _ = await jsRuntime.InvokeAsync<string>("toString");

            if (disposed)
                return;

            latency = DateTime.UtcNow - startTime;
            await base.InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Circuit was torn down mid-await; nothing left to update.
        }
        catch
        {
            latency = TimeSpan.FromMilliseconds(0);
        }
    }

    public void Dispose()
    {
        disposed = true;

        if (timeTimer != null)
        {
            try
            {
                timeTimer.Elapsed -= OnTimerElapsed;
                timeTimer.Dispose();
            }
            catch
            {

            }
        }

        unitOfWork?.Dispose();
    }

}